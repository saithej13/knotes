<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Milk Rates"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginBottom="16dp"
        android:gravity="center" />

    <!-- Rate Summaries -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <!-- CM Rate Summary -->
        <androidx.cardview.widget.CardView
            android:id="@+id/layoutCMRateSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CM (Combined Milk) Rate"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimary" />

                <TextView
                    android:id="@+id/textViewCMRateSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fat: ₹0.0/% | SNF: ₹0.0/%"
                    android:textSize="12sp"
                    android:textColor="@android:color/black" />

                <TextView
                    android:id="@+id/textViewCMRateDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Effective: DD/MM/YYYY"
                    android:textSize="10sp"
                    android:textColor="@android:color/darker_gray" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- BM Rate Summary -->
        <androidx.cardview.widget.CardView
            android:id="@+id/layoutBMRateSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BM (Buffalo Milk) Rate"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorAccent" />

                <TextView
                    android:id="@+id/textViewBMRateSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fat: ₹0.0/% | Max SNF: 8.0% | Penalty: ₹0.0/%"
                    android:textSize="12sp"
                    android:textColor="@android:color/black" />

                <TextView
                    android:id="@+id/textViewBMRateDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Effective: DD/MM/YYYY"
                    android:textSize="10sp"
                    android:textColor="@android:color/darker_gray" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/buttonAddCMRate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Add CM Rate"
            android:textSize="12sp" />

        <Button
            android:id="@+id/buttonAddBMRate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Add BM Rate"
            android:textSize="12sp" />

    </LinearLayout>

    <Button
        android:id="@+id/buttonRateCalculator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Rate Calculator"
        style="@style/Widget.Material3.Button.TextButton" />

    <WebView
        android:id="@+id/webViewRateChart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        />



    <!-- Rates List -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="All Rates"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewRates"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/textViewEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="No rates configured"
        android:textSize="16sp"
        android:textColor="@android:color/darker_gray"
        android:visibility="gone" />

</LinearLayout>